{
  "name": "salon-core",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve web --open",
    "build": "ng build web",
    "watch": "ng build web --watch --configuration development",
    "test": "pnpm test:jest --ci",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "pnpm test:jest --watch --coverage=false",
    "test:report": "node scripts/relatorio-de-testes.ts",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.app.json && tsc --noEmit -p apps/web/tsconfig.spec.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "ng lint && eslint scripts e2e playwright.config.ts --max-warnings 0",
    "dup:check": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@brunomonfardini/ui": "^0.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.5.2",
    "@playwright/test": "1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jest": "29.17.0",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-preset-angular": "17.0.3",
    "jscpd": "5.4.2",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "node --experimental-vm-modules node_modules/jest/bin/jest.js --bail --findRelatedTests --passWithNoTests --coverage=false"
    ],
    "*.html": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,scss,json,md,yml,yaml,js,mjs}": "prettier --write"
  }
}
